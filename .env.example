# Copie para .env e preencha só o que for usar. O demo não precisa de nenhuma.
# O `darkroom doctor` diz se cada variável existe; nunca imprime o valor.

# Voz paga com alinhamento por caractere (provedor "elevenlabs") — docs/voz.md
ELEVENLABS_API_KEY=

# Pauta: busca no YouTube (`darkroom pesquisa`) — docs/pauta-e-pesquisa.md
YOUTUBE_API_KEY=

# Busca de b-roll (`darkroom stock`) — docs/banco-de-imagens.md
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Python com mlx-audio ou faster-whisper para medir o tempo das palavras (gravação e TTS local)
# DARKROOM_PYTHON=/caminho/venv/bin/python

# Render
# RENDER_GL=angle            # angle (GPU, padrão) | swangle (CPU)
# RENDER_TMPDIR=/Volumes/Externo/darkroom-tmp
# REMOTION_BROWSER_EXECUTABLE=/caminho/chrome-headless-shell
